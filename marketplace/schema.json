{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundry.example/schemas/catalog-v1.json",
  "title": "Foundry connector catalog",
  "description": "Authored catalog contract; example-domain records are test fixtures only.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "connectors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/connector"
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "connectors"
  ],
  "additionalProperties": false,
  "$defs": {
    "icon": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "local"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "format": "relative-path"
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "remote"
            },
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            }
          },
          "required": [
            "kind",
            "url"
          ],
          "additionalProperties": false
        }
      ]
    },
    "endpoint": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "remote"
            },
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            }
          },
          "required": [
            "kind",
            "url"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "adapter"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "state": {
              "const": "unavailable"
            }
          },
          "required": [
            "kind",
            "id",
            "state"
          ],
          "additionalProperties": false
        }
      ]
    },
    "auth": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "none",
                "oauth"
              ]
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "api_key"
            },
            "placeholder": {
              "const": "credential"
            }
          },
          "required": [
            "kind",
            "placeholder"
          ],
          "additionalProperties": false
        }
      ]
    },
    "skill": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "revision": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        }
      },
      "required": [
        "id",
        "url",
        "revision"
      ],
      "additionalProperties": false
    },
    "server": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "transport": {
          "const": "streamable-http"
        },
        "endpoint": {
          "$ref": "#/$defs/endpoint"
        },
        "auth": {
          "$ref": "#/$defs/auth"
        },
        "headers": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[^\\r\\n]*$"
          }
        }
      },
      "required": [
        "id",
        "transport",
        "endpoint",
        "auth"
      ],
      "additionalProperties": false
    },
    "connector": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "fixture": {
          "type": "boolean"
        },
        "homepage": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "documentation": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "icon": {
          "$ref": "#/$defs/icon"
        },
        "servers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/server"
          },
          "minItems": 1
        },
        "skills": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/skill"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "displayName",
        "description",
        "servers"
      ],
      "additionalProperties": false
    }
  }
}
